/* 首页样式 — pages/index/index.wxss（莫兰迪） */

/* 头部卡片 */
.header-card {
  position: relative;
  background: linear-gradient(135deg, #8BA4B5 0%, #7B9EB0 50%, #6B8A9E 100%);
  color: #fff;
  border-radius: 24rpx;
  padding: 36rpx 28rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(123, 158, 176, 0.3);
  overflow: hidden;
}

.header-bg-decor {
  position: absolute;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  top: -120rpx;
  right: -80rpx;
}

.header-top {
  position: relative;
  z-index: 1;
}

.header-card .avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.header-card .nickname {
  font-size: 36rpx;
  font-weight: 600;
}

.header-card .sub-text {
  color: rgba(255, 255, 255, 0.8);
  font-size: 26rpx;
}

.header-card .highlight {
  color: #F5E6C8;
  font-weight: 600;
}

.checkin-badge {
  background: rgba(255, 255, 255, 0.25);
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  backdrop-filter: blur(10rpx);
}

/* 学习数据 */
.stats-row {
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 16rpx;
  padding: 24rpx 0;
  margin-top: 28rpx;
  position: relative;
  z-index: 1;
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 4rpx;
}

.stat-divider {
  width: 2rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.2);
}

/* 区块标题 */
.section-title {
  padding: 8rpx 4rpx 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #4A4A4A;
}

.link-text {
  color: #7B9EB0;
  font-size: 26rpx;
  font-weight: 400;
}

/* 单词列表 */
.word-list .word-item {
  border-left: 6rpx solid #C5D5DE;
  transition: transform 0.15s;
}

.word-list .word-item:active {
  transform: scale(0.98);
}

.word-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #4A4A4A;
}

.phonetic-text {
  font-size: 24rpx;
  color: #B5B0A8;
}

.meaning-text {
  font-size: 28rpx;
  color: #8A8A8A;
}

.status-tag {
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

.status-tag.learned {
  background: #E8EFE8;
  color: #9BAF9B;
}

.status-tag.new {
  background: #F0E8E8;
  color: #C9A9A6;
}

/* 快速入口 */
.quick-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.action-item {
  text-align: center;
  padding: 36rpx 16rpx 28rpx;
  transition: transform 0.15s;
}

.action-item:active {
  transform: scale(0.96);
}

.action-icon-circle {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin: 0 auto 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-icon-circle.bg-pink   { background: #F0E0DE; }
.action-icon-circle.bg-blue   { background: #E0EAF0; }
.action-icon-circle.bg-yellow { background: #F0EAD8; }
.action-icon-circle.bg-green  { background: #E4EBE2; }

.action-icon {
  font-size: 40rpx;
}

.action-text {
  display: block;
  font-size: 26rpx;
  color: #6A6A6A;
  font-weight: 500;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #B5B0A8;
}
