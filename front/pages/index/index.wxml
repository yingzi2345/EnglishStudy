<!--
  首页 — 学习首页（莫兰迪风格）
  pages/index/index.wxml
-->
<view class="container">
  <!-- 用户头部 -->
  <view class="header-card">
    <view class="header-bg-decor"></view>
    <view class="flex-row header-top">
      <image class="avatar" src="{{userInfo.avatar_url || '/images/default-avatar.png'}}" mode="aspectFill" lazy-load />
      <view class="flex-1 ml-16">
        <view class="nickname">{{userInfo.nickname || '微信用户'}}</view>
        <view class="sub-text mt-8">连续打卡 <text class="highlight">{{continuousDays}}</text> 天</view>
      </view>
      <view class="checkin-badge" wx:if="{{todayChecked}}">
        <text>已打卡</text>
      </view>
    </view>
    <!-- 学习数据 -->
    <view class="stats-row">
      <view class="stat-item">
        <view class="stat-value">{{userInfo.total_words || 0}}</view>
        <view class="stat-label">学习单词</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-value">{{userInfo.total_days || 0}}</view>
        <view class="stat-label">打卡天数</view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-value">{{userInfo.max_continuous || 0}}</view>
        <view class="stat-label">最长连续</view>
      </view>
    </view>
  </view>

  <!-- 今日学习横幅 -->
  <view class="study-banner card" bindtap="goToStudy">
    <view class="study-banner-left">
      <view class="study-banner-title">今日学习</view>
      <view class="study-banner-sub">
        <text wx:if="{{studyStats.due_review > 0}}">{{studyStats.due_review}} 个待复习</text>
        <text wx:else>暂无待复习</text>
        <text class="dot">·</text>
        <text>{{studyStats.wrong_count}} 个错词</text>
      </view>
      <!-- 今日目标进度 -->
      <view class="goal-progress mt-12">
        <view class="goal-progress-bar">
          <view class="goal-progress-fill" style="width: {{studyStats.today_learned >= dailyGoal ? 100 : (studyStats.today_learned / dailyGoal * 100)}}%;"></view>
        </view>
        <text class="goal-progress-text">{{studyStats.today_learned}}/{{dailyGoal}} 词</text>
      </view>
    </view>
    <view class="study-banner-btn">开始学习 ›</view>
  </view>

  <!-- 每日单词推荐 -->
  <view class="section-title flex-between">
    <text>今日推荐单词</text>
    <text class="link-text" bindtap="goToWords">查看更多 ›</text>
  </view>

  <view class="word-list">
    <view class="word-item card" wx:for="{{dailyWords}}" wx:key="id" bindtap="goToWordDetail" data-id="{{item.id}}">
      <view class="flex-between">
        <view>
          <text class="word-text">{{item.word}}</text>
          <text class="phonetic-text ml-16">{{item.phonetic}}</text>
        </view>
        <view class="status-tag {{item.is_learned ? 'learned' : 'new'}}">{{item.is_learned ? '已学' : '新词'}}</view>
      </view>
      <view class="meaning-text mt-8">{{item.meaning}}</view>
    </view>
    <view class="empty-tip" wx:if="{{dailyWords.length === 0}}">
      <text>暂无推荐单词</text>
    </view>
  </view>

  <!-- 快速入口 -->
  <view class="quick-actions mt-24">
    <view class="action-item card" bindtap="goToStudy">
      <view class="action-icon-circle bg-blue">
        <text class="action-icon">📚</text>
      </view>
      <text class="action-text">单词学习</text>
    </view>
    <view class="action-item card" bindtap="goToQuiz">
      <view class="action-icon-circle bg-purple">
        <text class="action-icon">✏️</text>
      </view>
      <text class="action-text">单词测验</text>
    </view>
    <view class="action-item card" bindtap="goToWrongWords">
      <view class="action-icon-circle bg-pink">
        <text class="action-icon">📕</text>
      </view>
      <text class="action-text">错词本</text>
    </view>
    <view class="action-item card" bindtap="goToCheckin">
      <view class="action-icon-circle bg-yellow">
        <text class="action-icon">📝</text>
      </view>
      <text class="action-text">每日打卡</text>
    </view>
    <view class="action-item card" bindtap="goToWords">
      <view class="action-icon-circle bg-green">
        <text class="action-icon">📖</text>
      </view>
      <text class="action-text">单词本</text>
    </view>
    <view class="action-item card" bindtap="goToLeaderboard">
      <view class="action-icon-circle bg-orange">
        <text class="action-icon">🏆</text>
      </view>
      <text class="action-text">排行榜</text>
    </view>
    <view class="action-item card" bindtap="goToVocabTest">
      <view class="action-icon-circle bg-purple">
        <text class="action-icon">📊</text>
      </view>
      <text class="action-text">词汇测试</text>
    </view>
  </view>
</view>
