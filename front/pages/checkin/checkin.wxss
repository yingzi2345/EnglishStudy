/* 打卡页样式 — pages/checkin/checkin.wxss */

.checkin-card {
  padding: 48rpx 24rpx;
  text-align: center;
  background: linear-gradient(135deg, #f5f7fa, #e8ecf1);
}

.checkin-card.checked {
  background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
}

.checkin-circle {
  position: relative;
  width: 220rpx;
  height: 220rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: linear-gradient(135deg, #4A90D9, #357ABD);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  box-shadow: 0 8rpx 32rpx rgba(74, 144, 217, 0.3);
  transition: all 0.3s;
}

.checkin-circle.checked {
  background: linear-gradient(135deg, #52c41a, #389e0d);
  box-shadow: 0 8rpx 32rpx rgba(82, 196, 26, 0.3);
}

.checkin-circle:active {
  transform: scale(0.95);
}

.checkin-day-label {
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
}

.checkin-date {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-top: 4rpx;
}

.checkin-icon {
  display: inline-block;
  font-size: 48rpx;
  color: #fff;
  margin-top: 8rpx;
}

.streak-info {
  display: flex;
  justify-content: center;
  align-items: center;
}

.streak-item {
  flex: 1;
  text-align: center;
}

.streak-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #333;
}

.streak-label {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

.streak-divider {
  width: 2rpx;
  height: 48rpx;
  background: #e8e8e8;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.study-item {
  text-align: center;
  flex: 1;
}

.study-value {
  font-size: 40rpx;
  font-weight: 700;
}

.study-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.month-picker {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.arrow {
  font-size: 24rpx;
  color: #4A90D9;
  padding: 8rpx;
}

.month-text {
  font-size: 28rpx;
  color: #333;
}

.weekday-row {
  display: flex;
  justify-content: space-around;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.weekday {
  width: 14.28%;
  text-align: center;
  font-size: 24rpx;
  color: #999;
}

.date-grid {
  display: flex;
  flex-wrap: wrap;
}

.date-cell {
  width: 14.28%;
  aspect-ratio: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 24rpx;
}

.date-cell.empty {
  visibility: hidden;
}

.date-cell.checked {
  background: #4A90D9;
  border-radius: 50%;
  color: #fff;
}

.date-cell.today {
  border: 2rpx solid #4A90D9;
  border-radius: 50%;
}

/* ────────── 日历火焰等级 ────────── */
.date-cell.checked.fire-1 {
  background: #fff3e0;
  color: #ef8b2c;
}
.date-cell.checked.fire-2 {
  background: #ffd8a8;
  color: #e8590c;
}
.date-cell.checked.fire-3 {
  background: #ffa94d;
  color: #fff;
}
.date-cell.checked.fire-4 {
  background: linear-gradient(135deg, #ff6b2c, #f03e3e);
  color: #fff;
}

.date-num {
  display: inline;
}

.fire-emoji {
  font-size: 16rpx;
  margin-left: 2rpx;
  vertical-align: middle;
}

/* 火焰图例 */
.fire-legend {
  gap: 8rpx;
  align-items: center;
  justify-content: flex-end;
}

.legend-label {
  font-size: 20rpx;
  color: #999;
  margin-right: 8rpx;
}

.legend-cell {
  width: 24rpx;
  height: 24rpx;
  border-radius: 6rpx;
}

.legend-cell.fire-1 { background: #fff3e0; }
.legend-cell.fire-2 { background: #ffd8a8; }
.legend-cell.fire-3 { background: #ffa94d; }
.legend-cell.fire-4 { background: #f03e3e; }

.legend-text {
  font-size: 20rpx;
  color: #bbb;
  margin-left: 8rpx;
}

/* ────────── 打卡庆祝动画 ────────── */

/* 圆环弹跳 */
.checkin-circle.celebrate {
  animation: ring-pop 0.6s ease;
}

@keyframes ring-pop {
  0%   { transform: scale(0.85); }
  50%  { transform: scale(1.1); }
  100% { transform: scale(1); }
}

/* 对勾弹出 */
.checkin-icon.pop {
  animation: check-pop 0.7s ease 0.15s both;
}

@keyframes check-pop {
  0%   { transform: scale(0); opacity: 0; }
  60%  { transform: scale(1.4); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

/* 粒子爆花 */
.particle-wrap {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 0;
  height: 0;
  pointer-events: none;
  z-index: 2;
}

.particle {
  position: absolute;
  left: 0;
  top: 0;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ffd700;
  animation: particle-burst 0.9s ease-out forwards;
}

.particle:nth-child(1) { --dx: -110rpx; --dy: -70rpx;  background: #ffd700; }
.particle:nth-child(2) { --dx: 110rpx;  --dy: -70rpx;  background: #ffa94d; }
.particle:nth-child(3) { --dx: -70rpx;  --dy: -110rpx; background: #ff6b2c; }
.particle:nth-child(4) { --dx: 70rpx;   --dy: -110rpx; background: #ffd700; }
.particle:nth-child(5) { --dx: -130rpx; --dy: 10rpx;   background: #ffa94d; }
.particle:nth-child(6) { --dx: 130rpx;  --dy: 10rpx;   background: #ffd700; }
.particle:nth-child(7) { --dx: -90rpx;  --dy: 60rpx;   background: #ff6b2c; }
.particle:nth-child(8) { --dx: 90rpx;   --dy: 60rpx;   background: #ffa94d; }

.particle.p2, .particle.p5, .particle.p8 { animation-delay: 0.05s; }
.particle.p3, .particle.p6 { animation-delay: 0.1s; }
.particle.p4, .particle.p7 { animation-delay: 0.15s; }

@keyframes particle-burst {
  0%   { transform: translate(0, 0) scale(1); opacity: 1; }
  100% { transform: translate(var(--dx), var(--dy)) scale(0.2); opacity: 0; }
}

/* ────────── 打卡海报入口 ────────── */
.poster-entry {
  display: inline-block;
  background: linear-gradient(135deg, #ff9a3d, #ff6b2c);
  color: #fff;
  font-size: 26rpx;
  padding: 12rpx 36rpx;
  border-radius: 40rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 44, 0.35);
}

.poster-entry:active {
  opacity: 0.85;
  transform: scale(0.96);
}

/* ────────── 打卡海报弹层 ────────── */
.poster-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.65);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.poster-modal {
  position: relative;
  width: 640rpx;
}

.poster-box {
  position: relative;
  width: 100%;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 60rpx rgba(0, 0, 0, 0.4);
}

.poster-canvas {
  width: 100%;
  height: 1108rpx; /* 300:520 比例 */
  display: block;
  background: #24598F;
}

.poster-loading {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.85);
}

.poster-actions {
  gap: 20rpx;
  margin-top: 32rpx;
}

.poster-btn {
  font-size: 28rpx;
}

.poster-close {
  position: absolute;
  top: -88rpx;
  right: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 30rpx;
}
