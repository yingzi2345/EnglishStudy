/* 打卡页样式 — pages/checkin/checkin.wxss（莫兰迪） */

.checkin-card {
  padding: 48rpx 24rpx 36rpx;
  text-align: center;
  background: linear-gradient(135deg, #EDF1F4, #E2E8ED);
  border-radius: 24rpx;
}

.checkin-card.checked {
  background: linear-gradient(135deg, #E8EDE6, #D8E2D6);
}

.checkin-circle {
  position: relative;
  width: 220rpx;
  height: 220rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: linear-gradient(135deg, #8BA4B5, #6B8A9E);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  box-shadow: 0 10rpx 36rpx rgba(123, 158, 176, 0.35);
  transition: all 0.3s;
}

.checkin-circle.checked {
  background: linear-gradient(135deg, #A8BBA0, #8BA084);
  box-shadow: 0 10rpx 36rpx rgba(155, 175, 155, 0.35);
}

.checkin-circle:active {
  transform: scale(0.95);
}

.checkin-day-label {
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
}

.checkin-date {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-top: 4rpx;
}

.checkin-icon {
  display: inline-block;
  font-size: 48rpx;
  color: #fff;
  margin-top: 8rpx;
}

.streak-info {
  display: flex;
  justify-content: center;
  align-items: center;
}

.streak-item {
  flex: 1;
  text-align: center;
}

.streak-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #4A4A4A;
}

.streak-label {
  font-size: 22rpx;
  color: #8A8A8A;
  display: block;
  margin-top: 4rpx;
}

.streak-divider {
  width: 2rpx;
  height: 48rpx;
  background: #D8D2C8;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #4A4A4A;
}

.study-item {
  text-align: center;
  flex: 1;
}

.study-value {
  font-size: 40rpx;
  font-weight: 700;
}

.study-label {
  font-size: 22rpx;
  color: #8A8A8A;
  margin-top: 4rpx;
}

.month-picker {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.arrow {
  font-size: 24rpx;
  color: #7B9EB0;
  padding: 8rpx;
}

.month-text {
  font-size: 28rpx;
  color: #4A4A4A;
}

.weekday-row {
  display: flex;
  justify-content: space-around;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #EDE8E0;
}

.weekday {
  width: 14.28%;
  text-align: center;
  font-size: 24rpx;
  color: #B5B0A8;
}

.date-grid {
  display: flex;
  flex-wrap: wrap;
}

.date-cell {
  width: 14.28%;
  aspect-ratio: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 24rpx;
  color: #6A6A6A;
}

.date-cell.empty {
  visibility: hidden;
}

.date-cell.checked {
  border-radius: 50%;
  color: #fff;
}

.date-cell.today {
  border: 2rpx solid #7B9EB0;
  border-radius: 50%;
}

/* ────────── 日历火焰等级（莫兰迪暖调） ────────── */
.date-cell.checked.fire-1 {
  background: #E8D5C4;
  color: #B08968;
}
.date-cell.checked.fire-2 {
  background: #D4A574;
  color: #fff;
}
.date-cell.checked.fire-3 {
  background: #C48B5A;
  color: #fff;
}
.date-cell.checked.fire-4 {
  background: linear-gradient(135deg, #C48B8B, #B07070);
  color: #fff;
}

.date-num {
  display: inline;
}

.fire-emoji {
  font-size: 16rpx;
  margin-left: 2rpx;
  vertical-align: middle;
}

/* 火焰图例 */
.fire-legend {
  gap: 8rpx;
  align-items: center;
  justify-content: flex-end;
}

.legend-label {
  font-size: 20rpx;
  color: #B5B0A8;
  margin-right: 8rpx;
}

.legend-cell {
  width: 24rpx;
  height: 24rpx;
  border-radius: 6rpx;
}

.legend-cell.fire-1 { background: #E8D5C4; }
.legend-cell.fire-2 { background: #D4A574; }
.legend-cell.fire-3 { background: #C48B5A; }
.legend-cell.fire-4 { background: #B07070; }

.legend-text {
  font-size: 20rpx;
  color: #C5BFB5;
  margin-left: 8rpx;
}

/* ────────── 打卡庆祝动画 ────────── */

.checkin-circle.celebrate {
  animation: ring-pop 0.6s ease;
}

@keyframes ring-pop {
  0%   { transform: scale(0.85); }
  50%  { transform: scale(1.1); }
  100% { transform: scale(1); }
}

.checkin-icon.pop {
  animation: check-pop 0.7s ease 0.15s both;
}

@keyframes check-pop {
  0%   { transform: scale(0); opacity: 0; }
  60%  { transform: scale(1.4); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

.particle-wrap {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 0;
  height: 0;
  pointer-events: none;
  z-index: 2;
}

.particle {
  position: absolute;
  left: 0;
  top: 0;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  animation: particle-burst 0.9s ease-out forwards;
}

.particle:nth-child(1) { --dx: -110rpx; --dy: -70rpx;  background: #D4C5A0; }
.particle:nth-child(2) { --dx: 110rpx;  --dy: -70rpx;  background: #D4A574; }
.particle:nth-child(3) { --dx: -70rpx;  --dy: -110rpx; background: #C9A9A6; }
.particle:nth-child(4) { --dx: 70rpx;   --dy: -110rpx; background: #D4C5A0; }
.particle:nth-child(5) { --dx: -130rpx; --dy: 10rpx;   background: #D4A574; }
.particle:nth-child(6) { --dx: 130rpx;  --dy: 10rpx;   background: #D4C5A0; }
.particle:nth-child(7) { --dx: -90rpx;  --dy: 60rpx;   background: #C9A9A6; }
.particle:nth-child(8) { --dx: 90rpx;   --dy: 60rpx;   background: #D4A574; }

.particle.p2, .particle.p5, .particle.p8 { animation-delay: 0.05s; }
.particle.p3, .particle.p6 { animation-delay: 0.1s; }
.particle.p4, .particle.p7 { animation-delay: 0.15s; }

@keyframes particle-burst {
  0%   { transform: translate(0, 0) scale(1); opacity: 1; }
  100% { transform: translate(var(--dx), var(--dy)) scale(0.2); opacity: 0; }
}

/* ────────── 打卡海报入口 ────────── */
.poster-entry {
  display: inline-block;
  background: linear-gradient(135deg, #D4A574, #C48B5A);
  color: #fff;
  font-size: 26rpx;
  padding: 14rpx 40rpx;
  border-radius: 40rpx;
  box-shadow: 0 6rpx 20rpx rgba(212, 165, 116, 0.35);
}

.poster-entry:active {
  opacity: 0.85;
  transform: scale(0.96);
}

/* ────────── 打卡海报弹层 ────────── */
.poster-overlay {
  position: fixed;
  inset: 0;
  background: rgba(60, 55, 50, 0.6);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.poster-modal {
  position: relative;
  width: 640rpx;
}

.poster-box {
  position: relative;
  width: 100%;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 60rpx rgba(60, 55, 50, 0.35);
}

.poster-canvas {
  width: 100%;
  height: 1108rpx;
  display: block;
  background: #6B8A9E;
}

.poster-loading {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.85);
}

.poster-actions {
  gap: 20rpx;
  margin-top: 32rpx;
}

.poster-btn {
  font-size: 28rpx;
}

.poster-close {
  position: absolute;
  top: -88rpx;
  right: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: 30rpx;
}
