.page {
  min-height: 100vh;
  background: #F0EDE8;
  padding: 32rpx 28rpx 60rpx;
  box-sizing: border-box;
}

.header {
  margin-bottom: 36rpx;
}
.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #3D4F5F;
  letter-spacing: 2rpx;
}
.subtitle {
  font-size: 26rpx;
  color: #8A9AA8;
  margin-top: 8rpx;
}
.create-btn {
  margin-top: 24rpx;
  display: inline-flex;
  align-items: center;
  background: #7B9EB0;
  color: #fff;
  font-size: 26rpx;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(123,158,176,0.25);
}
.create-btn .plus {
  font-size: 30rpx;
  margin-right: 6rpx;
}

.group {
  margin-bottom: 36rpx;
}
.group-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #6B7C8A;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
  border-left: 6rpx solid #7B9EB0;
  padding-left: 16rpx;
}

.book-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.book-card {
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  align-items: flex-start;
}
.book-icon {
  font-size: 56rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  width: 80rpx;
  text-align: center;
}
.book-info {
  flex: 1;
  min-width: 0;
}
.book-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.book-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #3D4F5F;
}
.book-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}
.tag-none { background: #E8E4DE; color: #8A9AA8; }
.tag-joined { background: #DDE5E0; color: #6B8A7A; }
.tag-current { background: #7B9EB0; color: #fff; }

.book-desc {
  font-size: 24rpx;
  color: #9AA8B2;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.book-meta {
  display: flex;
  gap: 20rpx;
  font-size: 22rpx;
  color: #8A9AA8;
  margin-top: 10rpx;
}
.progress-bar {
  margin-top: 12rpx;
  height: 8rpx;
  background: #EDE9E3;
  border-radius: 4rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #7B9EB0, #A8BBA0);
  border-radius: 4rpx;
  transition: width 0.3s;
}

.empty {
  text-align: center;
  color: #9AA8B2;
  font-size: 28rpx;
  padding: 80rpx 0;
}

/* 弹层 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.modal {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx 32rpx;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3D4F5F;
  text-align: center;
  margin-bottom: 28rpx;
}
.form-item {
  margin-bottom: 24rpx;
}
.form-label {
  font-size: 24rpx;
  color: #6B7C8A;
  display: block;
  margin-bottom: 10rpx;
}
.form-input {
  background: #F5F2ED;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: #3D4F5F;
}
.modal-tip {
  font-size: 22rpx;
  color: #9AA8B2;
  margin: 8rpx 0 24rpx;
  line-height: 1.5;
}
.modal-actions {
  display: flex;
  gap: 20rpx;
}
.btn-cancel, .btn-confirm {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 40rpx;
  font-size: 28rpx;
}
.btn-cancel {
  background: #EDE9E3;
  color: #6B7C8A;
}
.btn-confirm {
  background: #7B9EB0;
  color: #fff;
}
