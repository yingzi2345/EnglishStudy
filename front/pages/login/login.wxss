/* 登录页样式 — pages/login/login.wxss */

.login-container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  background: linear-gradient(180deg, #4A90D9 0%, #6CB3F5 50%, #f5f5f5 100%);
}

.logo-area {
  text-align: center;
  margin-bottom: 120rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 32rpx;
  background: #fff;
}

.app-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  margin-top: 24rpx;
}

.app-desc {
  font-size: 28rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 12rpx;
}

.login-form {
  width: 80%;
}

.wechat-btn {
  width: 100%;
  background: #fff;
  color: #333;
  border-radius: 48rpx;
  padding: 28rpx;
  font-size: 34rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.1);
}

.wechat-btn:active {
  background: #f0f0f0;
}

.privacy-tip {
  font-size: 22rpx;
}
