/* 登录页样式 — pages/login/login.wxss（莫兰迪） */

.login-page {
  position: relative;
  min-height: 100vh;
  background: linear-gradient(160deg, #C5D5DE 0%, #D4C5B0 45%, #F0EDE8 100%);
  overflow: hidden;
}

/* 背景装饰圆 */
.bg-decor {
  position: absolute;
  border-radius: 50%;
  opacity: 0.4;
}

.decor-1 {
  width: 400rpx;
  height: 400rpx;
  background: #C9A9A6;
  top: -120rpx;
  right: -100rpx;
  opacity: 0.3;
}

.decor-2 {
  width: 300rpx;
  height: 300rpx;
  background: #9BAF9B;
  bottom: 200rpx;
  left: -80rpx;
  opacity: 0.25;
}

.decor-3 {
  width: 200rpx;
  height: 200rpx;
  background: #A69BB5;
  top: 40%;
  right: 60rpx;
  opacity: 0.2;
}

.login-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  padding: 0 48rpx;
}

.logo-area {
  text-align: center;
  margin-bottom: 120rpx;
}

.logo-wrap {
  width: 180rpx;
  height: 180rpx;
  margin: 0 auto;
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 12rpx 40rpx rgba(92, 122, 138, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.logo {
  width: 130rpx;
  height: 130rpx;
}

.app-name {
  font-size: 50rpx;
  font-weight: 700;
  color: #4A4A4A;
  margin-top: 36rpx;
  letter-spacing: 4rpx;
}

.app-desc {
  font-size: 26rpx;
  color: #8A8A8A;
  margin-top: 14rpx;
  letter-spacing: 2rpx;
}

.login-form {
  width: 100%;
}

.wechat-btn {
  width: 100%;
  background: linear-gradient(135deg, #7B9EB0, #5C7A8A);
  color: #fff;
  border-radius: 48rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 10rpx 32rpx rgba(123, 158, 176, 0.4);
  letter-spacing: 2rpx;
}

.wechat-btn::after {
  border: none;
}

.wechat-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.privacy-tip {
  font-size: 22rpx;
  color: #B5B0A8;
  text-align: center;
  margin-top: 32rpx;
}
