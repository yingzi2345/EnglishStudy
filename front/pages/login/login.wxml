<!-- 登录页 — pages/login/login.wxml -->
<view class="container login-container">
  <view class="logo-area">
    <image class="logo" src="/images/logo.png" mode="aspectFit" />
    <view class="app-name">英语学习打卡</view>
    <view class="app-desc">坚持每天学习，遇见更好的自己</view>
  </view>

  <view class="login-form">
    <button class="btn-primary wechat-btn" bindtap="handleWechatLogin"
            loading="{{loading}}" disabled="{{loading}}">
      <text wx:if="{{!loading}}">微信一键登录</text>
      <text wx:else>登录中...</text>
    </button>
    <view class="privacy-tip mt-24 text-gray text-center">
      登录即表示同意《用户协议》和《隐私政策》
    </view>
  </view>
</view>
