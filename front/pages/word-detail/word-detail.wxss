/* 单词详情页样式 — pages/word-detail/word-detail.wxss */

.word-hero {
  text-align: center;
  padding: 48rpx 24rpx;
  background: linear-gradient(135deg, #7B9EB0, #A3BCC9);
  color: #fff;
}

.word-main {
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

/* 可点击发音 视觉提示 */
.tap-pronounce {
  transition: opacity 0.15s;
}

.tap-active {
  opacity: 0.7;
}

.word-hero .phonetic {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
}

.word-hero .meaning {
  font-size: 36rpx;
  font-weight: 500;
}

/* 英音/美音切换行 */
.accent-row {
  gap: 20rpx;
}

.accent-switch {
  display: flex;
  gap: 8rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 32rpx;
  padding: 6rpx;
}

.accent-tag {
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
  padding: 10rpx 24rpx;
  border-radius: 26rpx;
  transition: all 0.2s;
}

.accent-active {
  background: rgba(255,255,255,0.95);
  color: #7B9EB0;
  font-weight: 600;
}

.audio-btn {
  font-size: 28rpx;
  color: #F0E6C8;
  padding: 12rpx 20rpx;
}

.example-box {
  background: rgba(255,255,255,0.15);
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: left;
}

.example-title {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

.example-en {
  font-size: 28rpx;
  font-style: italic;
}

.example-zh {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
}

/* 词根词缀/近义反义区块 */
.enrich-box {
  background: rgba(255,255,255,0.12);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.enrich-title {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  margin-bottom: 10rpx;
}

.enrich-content {
  font-size: 28rpx;
  color: #fff;
  line-height: 1.6;
}

.enrich-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.enrich-tag {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

.tag-synonym {
  background: rgba(155, 175, 155, 0.3);
  color: #D8E5D4;
}

.tag-antonym {
  background: rgba(201, 169, 166, 0.3);
  color: #F0D8D5;
}

.tag-form {
  background: rgba(212, 197, 160, 0.3);
  color: #F0E8D0;
}

.word-meta {
  font-size: 24rpx;
}

.word-meta .meta-text {
  color: rgba(255,255,255,0.85);
}

.action-buttons {
  display: flex;
  gap: 16rpx;
}

.action-buttons .btn-outline, .action-buttons .btn-primary {
  flex: 1;
  font-size: 26rpx;
  padding: 16rpx;
}

.action-buttons .btn-undo {
  border-color: #D4A574;
  color: #D4A574;
}

.empty-state {
  text-align: center;
  padding: 160rpx 0;
  color: #ccc;
}
