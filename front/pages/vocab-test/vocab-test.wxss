/* 词汇量测试页样式 — pages/vocab-test/vocab-test.wxss */

.container {
  padding: 24rpx;
}

/* 介绍页 */
.intro-card {
  text-align: center;
  padding: 60rpx 32rpx;
  margin-top: 80rpx;
}

.intro-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.intro-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #4A4A4A;
}

.intro-desc {
  font-size: 28rpx;
  color: #8A8A8A;
  margin-top: 16rpx;
  line-height: 1.6;
}

.intro-tips {
  margin-top: 32rpx;
  text-align: left;
  display: inline-block;
}

.intro-tips text {
  display: block;
  font-size: 26rpx;
  color: #999;
  line-height: 2;
}

/* 答题页 */
.quiz-header {
  margin-bottom: 24rpx;
}

.progress-text {
  font-size: 26rpx;
  color: #7B9EB0;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.progress-bar {
  height: 8rpx;
  background: #E8E4DD;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #9BAF9B, #7B9EB0);
  border-radius: 4rpx;
  transition: width 0.3s;
}

.question-card {
  text-align: center;
  padding: 48rpx 32rpx;
  margin-bottom: 32rpx;
}

.question-word {
  font-size: 56rpx;
  font-weight: 700;
  color: #4A4A4A;
  letter-spacing: 2rpx;
}

.question-phonetic {
  font-size: 28rpx;
  color: #B5B0A8;
  margin-top: 12rpx;
}

.question-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 20rpx;
}

.options-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.option-item {
  background: #fff;
  border: 2rpx solid #E8E4DD;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  transition: all 0.2s;
}

.option-item.option-selected {
  border-color: #7B9EB0;
  background: #EDF1F4;
}

.option-text {
  font-size: 30rpx;
  color: #4A4A4A;
}

/* 结果页 */
.result-card {
  text-align: center;
  padding: 56rpx 32rpx;
  margin-top: 60rpx;
}

.result-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.result-label {
  font-size: 28rpx;
  color: #8A8A8A;
}

.result-vocab {
  font-size: 80rpx;
  font-weight: 800;
  color: #7B9EB0;
  margin: 16rpx 0;
}

.result-level {
  font-size: 30rpx;
  color: #9BAF9B;
  font-weight: 600;
  margin-bottom: 40rpx;
}

.result-stats {
  display: flex;
  justify-content: center;
  gap: 80rpx;
  margin-bottom: 48rpx;
}

.result-stat {
  text-align: center;
}

.result-stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #4A4A4A;
}

.result-stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.result-actions {
  display: flex;
  gap: 16rpx;
}

.result-actions button {
  flex: 1;
}
