/* 排行榜页样式 — pages/leaderboard/leaderboard.wxss（莫兰迪） */

/* 时间段切换 */
.period-tabs {
  display: flex;
  justify-content: space-between;
  background: #fff;
  border-radius: 40rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(92, 122, 138, 0.08);
}

.period-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #8A8A8A;
  transition: all 0.25s;
}

.period-tab.active {
  background: linear-gradient(135deg, #8BA4B5, #6B8A9E);
  color: #fff;
  font-weight: 500;
  box-shadow: 0 4rpx 14rpx rgba(123, 158, 176, 0.3);
}

/* 我的排名 */
.my-rank {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #EDF1F4, #E2E8ED);
  border-left: 6rpx solid #7B9EB0;
}

.rank-badge {
  background: #7B9EB0;
  color: #fff;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
  font-weight: 700;
}

.my-rank-label {
  font-size: 24rpx;
  color: #7B9EB0;
  font-weight: 500;
}

.rank-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
}

.rank-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #4A4A4A;
}

.rank-stats {
  font-size: 24rpx;
  color: #8A8A8A;
}

/* ────────── 领奖台 ────────── */
.podium {
  display: flex;
  justify-content: center;
  align-items: flex-end;
  padding: 40rpx 20rpx 20rpx;
  gap: 16rpx;
}

.podium-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.podium-col.col-1 {
  order: 2;
}
.podium-col.col-2 {
  order: 1;
}
.podium-col.col-3 {
  order: 3;
}

.crown {
  font-size: 40rpx;
  margin-bottom: -8rpx;
}

.podium-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}

.podium-avatar.avatar-gold {
  width: 104rpx;
  height: 104rpx;
  border-color: #F0E6C8;
  border-width: 5rpx;
}

.podium-name {
  font-size: 24rpx;
  color: #6A6A6A;
  margin-top: 10rpx;
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.podium-name.name-gold {
  color: #B09050;
  font-weight: 600;
  font-size: 26rpx;
}

.podium-words {
  font-size: 22rpx;
  color: #B5B0A8;
  margin-top: 2rpx;
}

.podium-bar {
  width: 100%;
  border-radius: 12rpx 12rpx 0 0;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 12rpx;
  margin-top: 12rpx;
}

.bar-gold {
  height: 140rpx;
  background: linear-gradient(180deg, #E0D0A0, #C9B878);
}

.bar-silver {
  height: 100rpx;
  background: linear-gradient(180deg, #D0D5DA, #B5BCC4);
}

.bar-bronze {
  height: 80rpx;
  background: linear-gradient(180deg, #D4B89C, #B89878);
}

.medal {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.85);
  color: #8A7A50;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bar-silver .medal { color: #6A7078; }
.bar-bronze .medal { color: #8A6A50; }

/* ────────── 第4名及以后列表 ────────── */
.rank-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.rank-num {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 26rpx;
  font-weight: 600;
  background: #F0EDE8;
  color: #8A8A8A;
}

.rank-detail {
  font-size: 24rpx;
  color: #B5B0A8;
}

.rank-days {
  font-size: 24rpx;
  color: #7B9EB0;
  font-weight: 500;
}

.empty-tip {
  text-align: center;
  padding: 120rpx 0;
  color: #B5B0A8;
}
