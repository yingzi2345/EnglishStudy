<!-- 排行榜页 — pages/leaderboard/leaderboard.wxml（莫兰迪） -->
<view class="container">
  <!-- 时间段切换 -->
  <view class="period-tabs">
    <view class="period-tab {{activePeriod === 'daily' ? 'active' : ''}}"
          bindtap="switchPeriod" data-period="daily">日榜</view>
    <view class="period-tab {{activePeriod === 'weekly' ? 'active' : ''}}"
          bindtap="switchPeriod" data-period="weekly">周榜</view>
    <view class="period-tab {{activePeriod === 'monthly' ? 'active' : ''}}"
          bindtap="switchPeriod" data-period="monthly">月榜</view>
    <view class="period-tab {{activePeriod === 'alltime' ? 'active' : ''}}"
          bindtap="switchPeriod" data-period="alltime">总榜</view>
  </view>

  <!-- 我的排名 -->
  <view class="my-rank card" wx:if="{{myRank}}">
    <view class="flex-row">
      <view class="rank-badge">{{myRank.rank}}</view>
      <image class="rank-avatar ml-16" src="{{myRank.avatar_url || '/images/default-avatar.png'}}" />
      <view class="ml-16">
        <text class="rank-name">{{myRank.nickname}}</text>
        <text class="rank-stats ml-16">{{myRank.words_count}}词 / {{myRank.days_count}}天</text>
      </view>
    </view>
    <text class="my-rank-label">我的排名</text>
  </view>

  <!-- 前三名领奖台 -->
  <view class="podium card" wx:if="{{topThree.length > 0}}">
    <!-- 第二名 -->
    <view class="podium-col col-2" wx:if="{{topThree[1]}}">
      <image class="podium-avatar" src="{{topThree[1].avatar_url || '/images/default-avatar.png'}}" />
      <view class="podium-name">{{topThree[1].nickname}}</view>
      <view class="podium-words">{{topThree[1].words_count}}词</view>
      <view class="podium-bar bar-silver">
        <text class="medal">2</text>
      </view>
    </view>
    <!-- 第一名 -->
    <view class="podium-col col-1" wx:if="{{topThree[0]}}">
      <view class="crown">👑</view>
      <image class="podium-avatar avatar-gold" src="{{topThree[0].avatar_url || '/images/default-avatar.png'}}" />
      <view class="podium-name name-gold">{{topThree[0].nickname}}</view>
      <view class="podium-words">{{topThree[0].words_count}}词</view>
      <view class="podium-bar bar-gold">
        <text class="medal">1</text>
      </view>
    </view>
    <!-- 第三名 -->
    <view class="podium-col col-3" wx:if="{{topThree[2]}}">
      <image class="podium-avatar" src="{{topThree[2].avatar_url || '/images/default-avatar.png'}}" />
      <view class="podium-name">{{topThree[2].nickname}}</view>
      <view class="podium-words">{{topThree[2].words_count}}词</view>
      <view class="podium-bar bar-bronze">
        <text class="medal">3</text>
      </view>
    </view>
  </view>

  <!-- 第4名及以后列表 -->
  <view class="rank-list mt-24" wx:if="{{restList.length > 0}}">
    <view class="rank-item card flex-between"
          wx:for="{{restList}}" wx:key="user_id">
      <view class="flex-row">
        <view class="rank-num">{{item.rank}}</view>
        <image class="rank-avatar ml-16" src="{{item.avatar_url || '/images/default-avatar.png'}}" />
        <view class="ml-16">
          <text class="rank-name">{{item.nickname}}</text>
          <text class="rank-detail ml-16">{{item.words_count}}词</text>
        </view>
      </view>
      <text class="rank-days">打卡{{item.days_count}}天</text>
    </view>
  </view>

  <view class="empty-tip" wx:if="{{rankList.length === 0}}">
    <text>暂无排行数据</text>
  </view>
</view>
