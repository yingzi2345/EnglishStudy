<!-- 单词本页（错词本 / 收藏本）— pages/wrong-words/wrong-words.wxml -->
<view class="wrong-page">
  <!-- 顶部 tab 切换 -->
  <view class="book-tabs">
    <view class="book-tab {{activeTab === 'wrong' ? 'active' : ''}}" bindtap="switchTab" data-tab="wrong">错词本</view>
    <view class="book-tab {{activeTab === 'favorite' ? 'active' : ''}}" bindtap="switchTab" data-tab="favorite">生词本</view>
  </view>

  <!-- 加载中 -->
  <view class="loading-box" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-box" wx:elif="{{list.length === 0}}">
    <view class="empty-icon">{{activeTab === 'wrong' ? '📚' : '★'}}</view>
    <view class="empty-title">{{activeTab === 'wrong' ? '错词本是空的' : '生词本是空的'}}</view>
    <view class="empty-desc">{{activeTab === 'wrong' ? '学习或测验中答错的单词会自动收集到这里' : '学习或查词时点 ★ 即可把单词加入生词本'}}</view>
    <button class="btn-primary empty-btn" bindtap="goStudy">去学习</button>
  </view>

  <!-- 单词列表 -->
  <view wx:else>
    <view class="wrong-header">
      <text class="wrong-count">共 {{total}} 个单词</text>
      <text class="wrong-tip" wx:if="{{activeTab === 'wrong'}}">答错的词会在明天自动安排复习</text>
      <text class="wrong-tip" wx:else>收藏的单词会汇总在这里方便复习</text>
    </view>

    <view class="wrong-list">
      <view class="wrong-item card" wx:for="{{list}}" wx:key="id">
        <view class="wrong-main" bindtap="goDetail" data-id="{{item.word}}">
          <view class="wrong-word">
            {{item.word_name}}
            <text class="word-phonetic" wx:if="{{item.phonetic}}">{{item.phonetic}}</text>
          </view>
          <view class="wrong-meaning">{{item.word_meaning}}</view>
        </view>
        <view class="wrong-meta">
          <view class="wrong-count-tag" wx:if="{{activeTab === 'wrong'}}">错{{item.wrong_count || 1}}次</view>
          <view class="wrong-count-tag fav-tag" wx:else>★ 已收藏</view>
          <view class="remove-btn" catchtap="removeItem" data-id="{{item.word}}" data-word="{{item.word_name}}">移除</view>
        </view>
      </view>
    </view>
  </view>
</view>
