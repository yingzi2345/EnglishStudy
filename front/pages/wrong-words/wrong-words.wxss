/* 错词本页 — pages/wrong-words/wrong-words.wxss（莫兰迪） */

.wrong-page {
  min-height: 100vh;
  background: #F0EDE8;
  padding: 24rpx;
  box-sizing: border-box;
}

.loading-box {
  text-align: center;
  padding: 200rpx 0;
  color: #B5B0A8;
}

/* ────────── 顶部 tab ────────── */
.book-tabs {
  display: flex;
  background: #E7E3DB;
  border-radius: 40rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.book-tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #8A8A8A;
  padding: 16rpx 0;
  border-radius: 36rpx;
  transition: all 0.25s;
}

.book-tab.active {
  background: #fff;
  color: #5C7A8A;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(92, 122, 138, 0.12);
}

/* ────────── 空状态 ────────── */
.empty-box {
  text-align: center;
  padding: 160rpx 48rpx;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #4A4A4A;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #8A8A8A;
  line-height: 1.6;
  margin-bottom: 48rpx;
}

.empty-btn {
  width: 60%;
  margin: 0 auto;
}

/* ────────── 头部 ────────── */
.wrong-header {
  padding: 8rpx 4rpx 20rpx;
}

.wrong-count {
  font-size: 28rpx;
  font-weight: 600;
  color: #4A4A4A;
}

.wrong-tip {
  display: block;
  font-size: 22rpx;
  color: #B5B0A8;
  margin-top: 6rpx;
}

/* ────────── 错词列表 ────────── */
.wrong-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.wrong-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 24rpx;
  border-left: 6rpx solid #C9A9A6;
}

.wrong-main {
  flex: 1;
  min-width: 0;
}

.wrong-word {
  font-size: 32rpx;
  font-weight: 600;
  color: #4A4A4A;
}

.word-phonetic {
  font-size: 24rpx;
  font-weight: 400;
  color: #A8A29A;
  margin-left: 12rpx;
}

.wrong-meaning {
  font-size: 26rpx;
  color: #8A8A8A;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wrong-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.wrong-count-tag {
  font-size: 20rpx;
  color: #C9A9A6;
  background: #F0E0DE;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

.wrong-count-tag.fav-tag {
  color: #B08D57;
  background: #F5EBDD;
}

.remove-btn {
  font-size: 24rpx;
  color: #B5B0A8;
  padding: 6rpx 16rpx;
  border: 1rpx solid #E0DCD4;
  border-radius: 20rpx;
}

.remove-btn:active {
  background: #F5F2ED;
}
