/* 学习进度页样式 — pages/my-progress/my-progress.wxss */

.loading-box {
  text-align: center;
  padding: 120rpx 0;
}

/* 进度概览 */
.progress-overview {
  text-align: center;
  padding: 36rpx 24rpx;
}

.overview-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

/* 进度环 */
.progress-ring-wrap {
  display: flex;
  justify-content: center;
}

.progress-ring {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: conic-gradient(#7B9EB0 0deg, #7B9EB0 var(--pct, 0deg), #e8e8e8 var(--pct, 0deg), #e8e8e8 360deg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* 降级方案：纯色圆环 */
.progress-ring {
  background: #e8f4fd;
  border: 8rpx solid #7B9EB0;
}

.ring-percent {
  font-size: 44rpx;
  font-weight: 700;
  color: #7B9EB0;
}

.ring-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 进度条 */
.progress-bar {
  height: 12rpx;
  background: #e8e8e8;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #7B9EB0, #5C7A8A);
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

/* 数据统计 */
.stats-row {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 学习记录列表 */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.progress-list {
  margin-top: 8rpx;
}

.progress-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.progress-item:last-child {
  border-bottom: none;
}

.progress-left {
  flex: 1;
  min-width: 0;
}

.word-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  display: block;
}

.word-meaning {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.progress-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.tag-learned {
  background: #E8EFF3;
  color: #7B9EB0;
}

.tag-mastered {
  background: #E8EDE6;
  color: #9BAF9B;
}

.learn-time {
  font-size: 20rpx;
  color: #ccc;
  margin-top: 4rpx;
}

/* 空状态 */
.empty-box {
  text-align: center;
  padding: 80rpx 0;
}

/* ────────── 30 天打卡热力图 ────────── */
.heatmap-range {
  font-size: 22rpx;
}

.heatmap-grid {
  display: grid;
  grid-template-columns: repeat(10, 1fr);
  gap: 8rpx;
  margin-top: 12rpx;
}

.heat-cell {
  aspect-ratio: 1;
  border-radius: 6rpx;
  background: #f0f0f0;
  transition: transform 0.15s;
}

.heat-cell:active {
  transform: scale(1.15);
}

.heat-cell.today {
  box-shadow: 0 0 0 3rpx #fff, 0 0 0 5rpx #7B9EB0;
}

.heat-cell.level-0 { background: #EDE8E0; }
.heat-cell.level-1 { background: #D5DEE4; }
.heat-cell.level-2 { background: #A8BCC8; }
.heat-cell.level-3 { background: #7B9EB0; }
.heat-cell.level-4 { background: #5C7A8A; }

.heatmap-footer {
  align-items: center;
}

.heat-legend {
  gap: 6rpx;
  align-items: center;
}

.legend-label {
  font-size: 20rpx;
  color: #999;
  margin: 0 4rpx;
}

.legend-cell {
  width: 24rpx;
  height: 24rpx;
  border-radius: 4rpx;
}

.legend-cell.level-0 { background: #EDE8E0; }
.legend-cell.level-1 { background: #D5DEE4; }
.legend-cell.level-2 { background: #A8BCC8; }
.legend-cell.level-3 { background: #7B9EB0; }
.legend-cell.level-4 { background: #5C7A8A; }

.heat-stats {
  font-size: 22rpx;
}

/* ────────── 30 天学习趋势（柱状图） ────────── */
.trend-chart {
  display: flex;
  margin-top: 16rpx;
}

.trend-axis-y {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-end;
  font-size: 18rpx;
  color: #bbb;
  width: 48rpx;
  padding-bottom: 0;
}

.trend-bars {
  flex: 1;
  display: flex;
  align-items: flex-end;
  height: 260rpx;
  gap: 4rpx;
  border-bottom: 2rpx solid #eee;
  padding-left: 8rpx;
}

.trend-bar-item {
  flex: 1;
  height: 100%;
  display: flex;
  align-items: flex-end;
}

.trend-bar {
  width: 100%;
  min-height: 6rpx;
  background: #f0f0f0;
  border-radius: 4rpx 4rpx 0 0;
  transition: background 0.2s;
}

.trend-bar.has-data {
  background: linear-gradient(180deg, #A3BCC9, #7B9EB0);
}

.trend-bar-item:active .trend-bar.has-data {
  background: #5C7A8A;
}

.trend-axis-x {
  font-size: 18rpx;
  color: #bbb;
}
