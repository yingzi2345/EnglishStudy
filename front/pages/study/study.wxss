/* 卡片式学习页 — pages/study/study.wxss（莫兰迪） */

.study-page {
  min-height: 100vh;
  background: #F0EDE8;
  padding: 24rpx;
  box-sizing: border-box;
}

.loading-box {
  text-align: center;
  padding: 200rpx 0;
  color: #B5B0A8;
}

/* ────────── 顶部工具栏 ────────── */
.study-toolbar {
  margin-bottom: 8rpx;
}

.mode-switch {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #E8EFF3;
  color: #5C7A8A;
  font-size: 26rpx;
  font-weight: 600;
  padding: 8rpx 24rpx;
  border-radius: 16rpx;
  line-height: 1.3;
}

.mode-switch-hint {
  font-size: 18rpx;
  color: #8FA8B5;
  font-weight: 400;
}

.toolbar-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.tool-icon {
  font-size: 26rpx;
  color: #8A8A8A;
  padding: 8rpx 16rpx;
}

.tool-icon.favorite {
  font-size: 40rpx;
  color: #C5BFB5;
  padding: 4rpx 8rpx;
}

.tool-icon.favorite.active {
  color: #D4A574;
}

/* ────────── 进度条 ────────── */
.progress-bar {
  height: 8rpx;
  background: #E0DCD4;
  border-radius: 4rpx;
  overflow: hidden;
  margin: 16rpx 0 12rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #8BA4B5, #6B8A9E);
  border-radius: 4rpx;
  transition: width 0.3s;
}

.progress-text {
  text-align: center;
  font-size: 24rpx;
  color: #8A8A8A;
  margin-bottom: 32rpx;
}

/* ────────── 翻转卡片 ────────── */
.card-wrap {
  perspective: 1200rpx;
  height: 560rpx;
  margin-bottom: 48rpx;
}

.flip-card {
  position: relative;
  width: 100%;
  height: 100%;
  transition: transform 0.5s;
  transform-style: preserve-3d;
  will-change: transform;
}

.flip-card.flipped {
  transform: rotateY(180deg);
}

.card-face {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 32rpx rgba(92, 122, 138, 0.12);
}

.card-front {
  background: linear-gradient(145deg, #FFFFFF, #F5F2ED);
}

.card-back {
  background: linear-gradient(145deg, #EDF1F4, #E2E8ED);
  transform: rotateY(180deg);
}

.task-tag {
  position: absolute;
  top: 28rpx;
  left: 28rpx;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

.tag-new {
  background: #F0E0DE;
  color: #C9A9A6;
}

.tag-review {
  background: #E0EAF0;
  color: #7B9EB0;
}

.word-big {
  font-size: 72rpx;
  font-weight: 700;
  color: #4A4A4A;
  letter-spacing: 4rpx;
}

.word-small {
  font-size: 40rpx;
  font-weight: 600;
  color: #5C7A8A;
  margin-bottom: 20rpx;
}

.phonetic {
  font-size: 30rpx;
  color: #8A8A8A;
  margin-top: 16rpx;
}

.audio-btn {
  margin-top: 32rpx;
  padding: 14rpx 40rpx;
  background: #E8EFF3;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #7B9EB0;
}

.audio-btn:active {
  opacity: 0.7;
}

.meaning-text {
  font-size: 34rpx;
  color: #4A4A4A;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 28rpx;
}

/* 看中文回忆英文模式：正面中文释义大字 */
.meaning-big {
  font-size: 52rpx;
  font-weight: 600;
  color: #4A4A4A;
  text-align: center;
  line-height: 1.5;
  padding: 0 20rpx;
}

.example-box {
  background: rgba(255, 255, 255, 0.6);
  border-radius: 16rpx;
  padding: 24rpx;
  width: 100%;
  box-sizing: border-box;
}

.example-en {
  font-size: 26rpx;
  color: #5C7A8A;
  font-style: italic;
  line-height: 1.5;
}

.example-zh {
  font-size: 24rpx;
  color: #8A8A8A;
  margin-top: 8rpx;
  line-height: 1.5;
}

.flip-hint {
  position: absolute;
  bottom: 28rpx;
  font-size: 22rpx;
  color: #B5B0A8;
}

/* ────────── 三档操作按钮 ────────── */
.action-buttons {
  display: flex;
  gap: 16rpx;
}

.btn-grade {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  padding: 20rpx 0;
  line-height: 1.4;
  border: none;
}

.btn-grade::after { border: none; }

.btn-grade:active {
  opacity: 0.85;
  transform: scale(0.97);
}

.grade-title {
  font-size: 30rpx;
  font-weight: 600;
}

.grade-sub {
  font-size: 20rpx;
  opacity: 0.85;
  margin-top: 4rpx;
}

/* 不认识：莫兰迪粉 */
.btn-hard {
  background: linear-gradient(135deg, #D4B5B2, #C49A97);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(201, 169, 166, 0.3);
}

/* 模糊：莫兰迪黄 */
.btn-vague {
  background: linear-gradient(135deg, #DED0B0, #CEBC92);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(212, 197, 160, 0.3);
}

/* 认识：莫兰迪绿 */
.btn-easy {
  background: linear-gradient(135deg, #A8BBA0, #8BA084);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(155, 175, 155, 0.3);
}

/* ────────── 总结页 ────────── */
.summary-card {
  text-align: center;
  padding: 60rpx 32rpx 40rpx;
  margin-top: 80rpx;
}

.summary-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.summary-title {
  font-size: 38rpx;
  font-weight: 600;
  color: #4A4A4A;
  margin-bottom: 40rpx;
}

.summary-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 32rpx;
}

.summary-item {
  text-align: center;
}

.summary-num {
  font-size: 48rpx;
  font-weight: 700;
  color: #4A4A4A;
}

.summary-num.text-green { color: #9BAF9B; }
.summary-num.text-yellow { color: #C9B47E; }
.summary-num.text-pink { color: #C9A9A6; }
.summary-num.text-gray { color: #B5B0A8; }

.summary-label {
  font-size: 24rpx;
  color: #8A8A8A;
  margin-top: 4rpx;
}

.summary-tip {
  font-size: 24rpx;
  color: #B5B0A8;
  margin-bottom: 40rpx;
  line-height: 1.5;
}

.summary-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.summary-back {
  font-size: 26rpx;
  color: #B5B0A8;
  padding: 16rpx;
}
