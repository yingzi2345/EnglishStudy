<!-- 打卡记录页 — pages/records/records.wxml -->
<view class="container">
  <view class="card">
    <view class="card-title">学习统计</view>
    <view class="stats-grid mt-16">
      <view class="stat-box">
        <text class="stat-num text-primary">{{totalDays}}</text>
        <text class="stat-label">总打卡天数</text>
      </view>
      <view class="stat-box">
        <text class="stat-num text-success">{{totalWords}}</text>
        <text class="stat-label">总学习单词</text>
      </view>
      <view class="stat-box">
        <text class="stat-num text-warning">{{maxContinuous}}</text>
        <text class="stat-label">最长连续</text>
      </view>
    </view>
  </view>

  <!-- 记录列表 -->
  <view class="card mt-24">
    <view class="card-title">打卡记录</view>
    <view class="record-list mt-16">
      <view class="record-item flex-between" wx:for="{{records}}" wx:key="id">
        <view class="flex-row">
          <view class="record-date-box">
            <text class="record-day">{{item.checkin_date.split('-')[2] || ''}}</text>
            <text class="record-month">{{item.checkin_date.split('-')[1] || ''}}月</text>
          </view>
          <view class="ml-16">
            <text class="record-word">学习 {{item.word_count}} 个单词</text>
            <text class="record-duration ml-16 text-gray">· {{item.study_duration}} 分钟</text>
          </view>
        </view>
        <text class="text-primary">连续{{item.continuous_days}}天</text>
      </view>
      <view class="empty-tip" wx:if="{{records.length === 0}}">
        <text>暂无打卡记录，快去打卡吧！</text>
      </view>
    </view>
  </view>
</view>
